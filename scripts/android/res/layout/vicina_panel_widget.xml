<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vicina_aw_panel"
    android:orientation="horizontal"
    android:padding="6dp">
    <TextView android:id="@+id/vicina_p1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/vicina_aw_red" android:gravity="center" android:text="SOS" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/vicina_p2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/vicina_call_bg" android:gravity="center" android:text="112" android:textColor="#E8192C" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/vicina_p3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/vicina_aw_amber" android:gravity="center" android:text="Sirena" android:textColor="#1A1200" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/vicina_p4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/vicina_aw_dark" android:gravity="center" android:text="Torcia" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
